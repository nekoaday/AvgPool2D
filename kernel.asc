#include "kernel_operator.h"

namespace {
using namespace AscendC;
constexpr int32_t OUTPUT_TILE = 128;
constexpr int32_t INPUT_TILE = 1024;

__aicore__ inline void accumulate(LocalTensor<float> sum, LocalTensor<float> row,
                                   LocalTensor<float> scratch, int32_t n)
{
    Add(sum, sum, row, n);
}

__aicore__ inline void accumulate(LocalTensor<float> sum, LocalTensor<half> row,
                                   LocalTensor<float> scratch, int32_t n)
{
    Cast(scratch, row, RoundMode::CAST_NONE, n);
    PipeBarrier<PIPE_V>();
    Add(sum, sum, scratch, n);
}

template <typename T>
class Pool {
public:
    __aicore__ inline void run(GM_ADDR x, GM_ADDR y, int64_t h, int64_t w,
                               int64_t ho, int64_t wo, int64_t total, int64_t k, int64_t s)
    {
        input.SetGlobalBuffer((__gm__ T*)x);
        output.SetGlobalBuffer((__gm__ T*)y);
        pipe.InitBuffer(inQueue, 1, INPUT_TILE * sizeof(T));
        pipe.InitBuffer(outQueue, 1, OUTPUT_TILE * sizeof(T));
        pipe.InitBuffer(sumBuf, INPUT_TILE * sizeof(float));
        pipe.InitBuffer(castBuf, INPUT_TILE * sizeof(float));
        auto sum = sumBuf.Get<float>();
        const float scale = 1.0f / (static_cast<float>(k) * static_cast<float>(k));
        for (int64_t base = static_cast<int64_t>(GetBlockIdx()) * OUTPUT_TILE;
             base < total; base += static_cast<int64_t>(GetBlockNum()) * OUTPUT_TILE) {
            const int32_t count = total - base < OUTPUT_TILE ? total - base : OUTPUT_TILE;
            auto result = outQueue.AllocTensor<T>();
            int32_t pos = 0;
            while (pos < count) {
                const int64_t index = base + pos;
                const int64_t col = index % wo;
                const int64_t row = index / wo % ho;
                const int64_t batch = index / wo / ho;
                const int64_t origin = (batch * h + row * s) * w + col * s;
                const int64_t fit = k <= INPUT_TILE ? (INPUT_TILE - k) / s + 1 : 1;
                int32_t group = count - pos;
                if (group > wo - col) group = wo - col;
                if (group > fit) group = fit;
                const int64_t span = (group - 1) * s + k;
                float partial = 0;
                for (int64_t offset = 0; offset < span; offset += INPUT_TILE) {
                    const int32_t n = span - offset < INPUT_TILE ? span - offset : INPUT_TILE;
                    Duplicate(sum, 0.0f, n);
                    PipeBarrier<PIPE_V>();
                    for (int64_t dy = 0; dy < k; ++dy) {
                        auto local = inQueue.AllocTensor<T>();
                        DataCopyExtParams copy{1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0};
                        DataCopyPadExtParams<T> pad{false, 0, 0, 0};
                        DataCopyPad(local, input[origin + dy * w + offset], copy, pad);
                        inQueue.EnQue(local);
                        local = inQueue.DeQue<T>();
                        accumulate(sum, local, castBuf.Get<float>(), n);
                        PipeBarrier<PIPE_V>();
                        inQueue.FreeTensor(local);
                    }
                    SetFlag<HardEvent::V_S>(EVENT_ID0);
                    WaitFlag<HardEvent::V_S>(EVENT_ID0);
                    for (int32_t j = 0; j < group; ++j) {
                        float value = partial;
                        const int32_t start = j * s;
                        const int32_t width = k < n ? k : n;
                        for (int32_t dx = 0; dx < width; ++dx) value += sum.GetValue(start + dx);
                        if (offset + n == span) result.SetValue(pos + j, static_cast<T>(value * scale));
                        else partial = value;  // Split spans occur only for one oversized window.
                    }
                    SetFlag<HardEvent::S_V>(EVENT_ID0);
                    WaitFlag<HardEvent::S_V>(EVENT_ID0);
                }
                pos += group;
            }
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            outQueue.EnQue(result);
            result = outQueue.DeQue<T>();
            DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            DataCopyPad(output[base], result, copy);
            SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
            outQueue.FreeTensor(result);
        }
    }
private:
    GlobalTensor<T> input, output;
    TPipe pipe;
    TQue<QuePosition::VECIN, 1> inQueue;
    TQue<QuePosition::VECOUT, 1> outQueue;
    TBuf<QuePosition::VECCALC> sumBuf, castBuf;
};

// Store vector results directly in the output queue, narrowing only after scaling.
__aicore__ inline void finishRow(LocalTensor<float> dst, LocalTensor<float> sums,
                                  float scale, int32_t n)
{
    Muls(dst, sums, scale, n);
}

__aicore__ inline void finishRow(LocalTensor<half> dst, LocalTensor<float> sums,
                                  float scale, int32_t n)
{
    Muls(sums, sums, scale, n);
    PipeBarrier<PIPE_V>();
    Cast(dst, sums, RoundMode::CAST_RINT, n);
}

}  // namespace

template <typename T>
__global__ __vector__ void small_pool(GM_ADDR x, GM_ADDR y, int64_t h, int64_t w,
    int64_t ho, int64_t wo, int64_t total, int32_t k, int32_t stride)
{
    constexpr int32_t alignment = 32 / sizeof(T);
    const int64_t blocks = (total + alignment - 1) / alignment;
    const int64_t core = GetBlockIdx();
    const int64_t cores = GetBlockNum();
    int64_t pos = (blocks * core / cores) * alignment;
    int64_t end = (blocks * (core + 1) / cores) * alignment;
    if (end > total) end = total;
    const int32_t capacity = wo < OUTPUT_TILE ? wo : OUTPUT_TILE;
    const int32_t maxSpan = (capacity - 1) * stride + k;
    const int32_t maxPitch = (maxSpan + alignment - 1) / alignment * alignment;
    TPipe pipe;
    TQue<QuePosition::VECIN, 1> iq;
    TQue<QuePosition::VECOUT, 1> oq;
    TBuf<QuePosition::VECCALC> sumBuf, scratchBuf, offsetBuf, gatherBuf, resultBuf;
    pipe.InitBuffer(iq, 1, k * maxPitch * sizeof(T));
    pipe.InitBuffer(oq, 1, OUTPUT_TILE * sizeof(T));
    pipe.InitBuffer(sumBuf, maxPitch * sizeof(float));
    pipe.InitBuffer(scratchBuf, maxPitch * sizeof(float));
    pipe.InitBuffer(offsetBuf, OUTPUT_TILE * sizeof(uint32_t));
    pipe.InitBuffer(gatherBuf, OUTPUT_TILE * sizeof(float));
    pipe.InitBuffer(resultBuf, OUTPUT_TILE * sizeof(float));
    GlobalTensor<T> input, output;
    input.SetGlobalBuffer((__gm__ T*)x);
    output.SetGlobalBuffer((__gm__ T*)y);
    auto offsets = offsetBuf.Get<uint32_t>();
    for (int32_t j = 0; j < capacity; ++j) offsets.SetValue(j, j * stride * sizeof(float));
    SetFlag<HardEvent::S_V>(EVENT_ID0);
    WaitFlag<HardEvent::S_V>(EVENT_ID0);
    auto vertical = sumBuf.Get<float>();
    auto values = resultBuf.Get<float>();
    auto gathered = gatherBuf.Get<float>();
    while (pos < end) {
        const int64_t col = pos % wo;
        int32_t n = capacity;
        if (n > wo - col) n = wo - col;
        if (n > end - pos) n = end - pos;
        const int32_t span = (n - 1) * stride + k;
        const int32_t pitch = (span + alignment - 1) / alignment * alignment;
        const int64_t line = pos / wo;
        const int64_t origin = ((line / ho) * h + (line % ho) * stride) * w + col * stride;
        auto rows = iq.AllocTensor<T>();
        DataCopyExtParams copy{static_cast<uint16_t>(k), static_cast<uint32_t>(span * sizeof(T)),
                               static_cast<uint32_t>((w - span) * sizeof(T)), 0, 0};
        DataCopyPadExtParams<T> pad{false, 0, 0, 0};
        DataCopyPad(rows, input[origin], copy, pad);
        iq.EnQue(rows);
        rows = iq.DeQue<T>();
        Duplicate(vertical, 0.0f, span);
        PipeBarrier<PIPE_V>();
        for (int32_t dy = 0; dy < k; ++dy) {
            accumulate(vertical, rows[dy * pitch], scratchBuf.Get<float>(), span);
            PipeBarrier<PIPE_V>();
        }
        iq.FreeTensor(rows);
        Gather(values, vertical, offsets, 0u, n);
        for (int32_t dx = 1; dx < k; ++dx) {
            Gather(gathered, vertical, offsets, dx * sizeof(float), n);
            PipeBarrier<PIPE_V>();
            Add(values, values, gathered, n);
            PipeBarrier<PIPE_V>();
        }
        PipeBarrier<PIPE_V>();
        auto result = oq.AllocTensor<T>();
        finishRow(result, values, 1.0f / (k * k), n);
        oq.EnQue(result);
        result = oq.DeQue<T>();
        DataCopyExtParams write{1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0};
        DataCopyPad(output[pos], result, write);
        oq.FreeTensor(result);
        pos += n;
    }
}

template <typename T>
__global__ __vector__ void avg_pool2_d_custom(GM_ADDR x, GM_ADDR y, int64_t h, int64_t w,
    int64_t ho, int64_t wo, int64_t total, int64_t k, int64_t s)
{
    Pool<T> pool;
    pool.run(x, y, h, w, ho, wo, total, k, s);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y,
    const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream,
    int64_t kernel_size, int64_t stride)
{
    const auto* in = info_x.tensors[0].shape;
    const auto* out = info_y.tensors[0].shape;
    const int64_t total = out[0] * out[1] * out[2];
    if (total == 0) return;
    // Small windows fit in one strided DMA. Bound the GM byte stride as well.
    if (kernel_size <= 8 && stride <= 8 && in[2] <= INT32_MAX / 4) {
        const int32_t align = info_x.tensors[0].dtype == 0 ? 8 : 16;
        const int64_t blocks = (total + align - 1) / align;
        const uint32_t cores = availableCoreNum < 1 ? 1 : (blocks < availableCoreNum ? blocks : availableCoreNum);
        if (info_x.tensors[0].dtype == 0) {
            small_pool<float><<<cores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, stride);
        } else {
            small_pool<half><<<cores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, stride);
        }
        return;
    }
    const int64_t tiles = (total - 1) / OUTPUT_TILE + 1;
    const uint32_t cores = availableCoreNum < 1 ? 1 : (tiles < availableCoreNum ? tiles : availableCoreNum);
    if (info_x.tensors[0].dtype == 0) {
        avg_pool2_d_custom<float><<<cores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, stride);
    } else {
        avg_pool2_d_custom<half><<<cores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, stride);
    }
}
