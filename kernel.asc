#include <type_traits>
#include "kernel_operator.h"

namespace {
using namespace AscendC;
constexpr int32_t OUTPUT_TILE = 256;
constexpr int32_t INPUT_TILE = 1024;

__aicore__ inline void accumulate(LocalTensor<float> sum, LocalTensor<float> row,
                                   LocalTensor<float> scratch, int32_t n)
{
    Add(sum, sum, row, n);
}

__aicore__ inline void accumulate(LocalTensor<float> sum, LocalTensor<half> row,
                                   LocalTensor<float> scratch, int32_t n)
{
    Cast(scratch, row, RoundMode::CAST_NONE, n);
    PipeBarrier<PIPE_V>();
    Add(sum, sum, scratch, n);
}

template <typename T>
class Pool {
public:
    __aicore__ inline void run(GM_ADDR x, GM_ADDR y, int64_t h, int64_t w,
                               int64_t ho, int64_t wo, int64_t total, int64_t k, int64_t s)
    {
        input.SetGlobalBuffer((__gm__ T*)x);
        output.SetGlobalBuffer((__gm__ T*)y);
        pipe.InitBuffer(inQueue, 1, INPUT_TILE * sizeof(T));
        pipe.InitBuffer(outQueue, 1, OUTPUT_TILE * sizeof(T));
        pipe.InitBuffer(sumBuf, INPUT_TILE * sizeof(float));
        pipe.InitBuffer(castBuf, INPUT_TILE * sizeof(float));
        auto sum = sumBuf.Get<float>();
        const float scale = 1.0f / (static_cast<float>(k) * static_cast<float>(k));
        for (int64_t base = static_cast<int64_t>(GetBlockIdx()) * OUTPUT_TILE;
             base < total; base += static_cast<int64_t>(GetBlockNum()) * OUTPUT_TILE) {
            const int32_t count = total - base < OUTPUT_TILE ? total - base : OUTPUT_TILE;
            auto result = outQueue.AllocTensor<T>();
            int32_t pos = 0;
            while (pos < count) {
                const int64_t index = base + pos;
                const int64_t col = index % wo;
                const int64_t row = index / wo % ho;
                const int64_t batch = index / wo / ho;
                const int64_t origin = (batch * h + row * s) * w + col * s;
                const int64_t fit = k <= INPUT_TILE ? (INPUT_TILE - k) / s + 1 : 1;
                int32_t group = count - pos;
                if (group > wo - col) group = wo - col;
                if (group > fit) group = fit;
                const int64_t span = (group - 1) * s + k;
                float partial = 0;
                for (int64_t offset = 0; offset < span; offset += INPUT_TILE) {
                    const int32_t n = span - offset < INPUT_TILE ? span - offset : INPUT_TILE;
                    Duplicate(sum, 0.0f, n);
                    PipeBarrier<PIPE_V>();
                    for (int64_t dy = 0; dy < k; ++dy) {
                        auto local = inQueue.AllocTensor<T>();
                        DataCopyExtParams copy{1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0};
                        DataCopyPadExtParams<T> pad{false, 0, 0, 0};
                        DataCopyPad(local, input[origin + dy * w + offset], copy, pad);
                        inQueue.EnQue(local);
                        local = inQueue.DeQue<T>();
                        accumulate(sum, local, castBuf.Get<float>(), n);
                        PipeBarrier<PIPE_V>();
                        inQueue.FreeTensor(local);
                    }
                    SetFlag<HardEvent::V_S>(EVENT_ID0);
                    WaitFlag<HardEvent::V_S>(EVENT_ID0);
                    for (int32_t j = 0; j < group; ++j) {
                        float value = partial;
                        const int32_t start = j * s;
                        const int32_t width = k < n ? k : n;
                        for (int32_t dx = 0; dx < width; ++dx) value += sum.GetValue(start + dx);
                        if (offset + n == span) result.SetValue(pos + j, static_cast<T>(value * scale));
                        else partial = value;  // Split spans occur only for one oversized window.
                    }
                    SetFlag<HardEvent::S_V>(EVENT_ID0);
                    WaitFlag<HardEvent::S_V>(EVENT_ID0);
                }
                pos += group;
            }
            SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
            outQueue.EnQue(result);
            result = outQueue.DeQue<T>();
            DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
            DataCopyPad(output[base], result, copy);
            SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
            WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);
            outQueue.FreeTensor(result);
        }
    }
private:
    GlobalTensor<T> input, output;
    TPipe pipe;
    TQue<QuePosition::VECIN, 1> inQueue;
    TQue<QuePosition::VECOUT, 1> outQueue;
    TBuf<QuePosition::VECCALC> sumBuf, castBuf;
};

// Store vector results directly in the output queue, narrowing only after scaling.
__aicore__ inline void finishRow(LocalTensor<float> dst, LocalTensor<float> sums,
                                  float scale, int32_t n)
{
    Muls(dst, sums, scale, n);
}

__aicore__ inline void finishRow(LocalTensor<half> dst, LocalTensor<float> sums,
                                  float scale, int32_t n)
{
    Muls(sums, sums, scale, n);
    PipeBarrier<PIPE_V>();
    Cast(dst, sums, RoundMode::CAST_RINT, n);
}

__aicore__ inline void addRowPair(LocalTensor<float> sum, LocalTensor<float> scratch,
                                  LocalTensor<float> rows, int32_t pitch, int32_t span)
{
    Add(sum, rows, rows[pitch], span);
}

__aicore__ inline void addRowPair(LocalTensor<float> sum, LocalTensor<float> scratch,
                                  LocalTensor<half> rows, int32_t pitch, int32_t span)
{
    Cast(sum, rows, RoundMode::CAST_NONE, span);
    Cast(scratch, rows[pitch], RoundMode::CAST_NONE, span);
    PipeBarrier<PIPE_V>();
    Add(sum, sum, scratch, span);
}

__aicore__ inline void reducePairs(LocalTensor<float> values, LocalTensor<float> vertical,
                                   int32_t n)
{
    // Each full repeat reads 64 floats and writes 32 consecutive pair sums.
    const int32_t repeats = n / 32;
    const int32_t tail = n % 32;
    if (repeats) PairReduceSum(values, vertical, repeats, 64, 1, 1, 8);
    if (tail) PairReduceSum(values[repeats * 32], vertical[repeats * 64], 1, tail * 2, 1, 1, 8);
}

}  // namespace

namespace {
constexpr int32_t STRIP_ROWS = 8;
constexpr int32_t STRIP_COLS = 256;

__aicore__ inline LocalTensor<float> widenRows(LocalTensor<float> src, LocalTensor<float> tmp, int32_t n)
{
    return src;
}

__aicore__ inline LocalTensor<float> widenRows(LocalTensor<half> src, LocalTensor<float> tmp, int32_t n)
{
    Cast(tmp, src, RoundMode::CAST_NONE, n);
    PipeBarrier<PIPE_V>();
    return tmp;
}

__aicore__ inline void makeOffsets(LocalTensor<float> lanes, LocalTensor<int32_t> offsets,
                                   int32_t stride, int32_t n)
{
    CreateVecIndex(lanes, 0.0f, n);
    PipeBarrier<PIPE_V>();
    constexpr int32_t elementBytes = static_cast<int32_t>(sizeof(float));
    Muls(lanes, lanes, static_cast<float>(stride * elementBytes), n);
    PipeBarrier<PIPE_V>();
    Cast(offsets, lanes, RoundMode::CAST_RINT, n);
    PipeBarrier<PIPE_V>();
}
}  // namespace

// Each core owns a contiguous, 32-byte-delimited interval of output. Split at
// batch boundaries and peel partial rows before scheduling full rectangles.
template <bool halfInput, int32_t stride, bool useDoubling = false>
__global__ __vector__ void strip_pool(GM_ADDR x, GM_ADDR y, int64_t h, int64_t w,
    int64_t ho, int64_t wo, int64_t total, int32_t k, int64_t unit)
{
    using T = typename std::conditional<halfInput, half, float>::type;
    constexpr int32_t align = 32 / sizeof(T);
    const bool paired = stride == 2 && k == 2;
    const int32_t cols = wo < STRIP_COLS ? wo : STRIP_COLS;
    // Pad each input row to stride times an aligned output pitch. A single
    // regular Gather index then works across all rows, even at odd widths.
    const int32_t maxCols = cols - 1 + (k + stride - 1) / stride;
    const int32_t maxOutPitch = (maxCols + align - 1) / align * align;
    const int32_t maxPitch = stride * maxOutPitch;
    const int32_t slab = (stride == 2 ? k * STRIP_ROWS : STRIP_ROWS + k - 1) * maxPitch;
    const int32_t work = STRIP_ROWS * maxOutPitch;
    const int32_t windowScratch = useDoubling ? work + 32 : work;
    TPipe pipe;
    TQue<QuePosition::VECIN, 1> iq;
    TQue<QuePosition::VECOUT, 1> oq;
    TBuf<QuePosition::VECCALC> wideBuf, sumBuf, valueBuf, gatherBuf, offsetBuf, powerBuf;
    pipe.InitBuffer(iq, 1, slab * sizeof(T));
    pipe.InitBuffer(oq, 1, work * sizeof(T));
    // A float input can be consumed directly.
    pipe.InitBuffer(wideBuf, sizeof(T) == sizeof(half) ? slab * sizeof(float) : 32);
    pipe.InitBuffer(sumBuf, stride * work * sizeof(float));
    pipe.InitBuffer(valueBuf, windowScratch * sizeof(float));
    if (!paired) {
        pipe.InitBuffer(gatherBuf, windowScratch * sizeof(float));
        pipe.InitBuffer(offsetBuf, windowScratch * sizeof(uint32_t));
        if (useDoubling) pipe.InitBuffer(powerBuf, 5 * windowScratch * sizeof(float));
        makeOffsets(valueBuf.Get<float>(), offsetBuf.Get<int32_t>(), stride, windowScratch);
    }
    GlobalTensor<T> input, output;
    input.SetGlobalBuffer((__gm__ T*)x);
    output.SetGlobalBuffer((__gm__ T*)y);
    const int64_t blocks = (total - 1) / unit + 1;
    int64_t pos = (blocks * GetBlockIdx() / GetBlockNum()) * unit;
    int64_t end = (blocks * (GetBlockIdx() + 1) / GetBlockNum()) * unit;
    if (end > total) end = total;
    const float scale = 1.0f / (k * k);
    while (pos < end) {
        const int64_t line = pos / wo;
        const int64_t row = line % ho;
        const int64_t col = pos % wo;
        int64_t width = wo - col;
        if (width > end - pos) width = end - pos;
        int32_t nr = 1;
        if (col == 0 && width == wo) {
            int64_t remaining = (end - pos) / wo;
            if (remaining > ho - row) remaining = ho - row;
            nr = remaining < STRIP_ROWS ? remaining : STRIP_ROWS;
        }
        for (int64_t left = 0; left < width; left += cols) {
            const int32_t n = width - left < cols ? width - left : cols;
            const int32_t span = (n - 1) * stride + k;
            const int32_t natural = (span + align - 1) / align * align;
            const int32_t outCols = n - 1 + (k + stride - 1) / stride;
            const int32_t outPitch = (outCols + align - 1) / align * align;
            const int32_t pitch = stride * outPitch;
            const int32_t used = (nr - 1) * outPitch + n;
            const int64_t origin = ((line / ho) * h + row * stride) * w + (col + left) * stride;
            auto rows = iq.AllocTensor<T>();
            DataCopyPadExtParams<T> pad{false, 0, 0, 0};
            if (stride == 2) {
                // Pack rows with the same dy into one sheet for a batched Add.
                DataCopyExtParams copy{static_cast<uint16_t>(nr), static_cast<uint32_t>(span * sizeof(T)),
                    static_cast<uint32_t>((2 * w - span) * sizeof(T)), static_cast<uint32_t>((pitch - natural) / align), 0};
                for (int32_t dy = 0; dy < k; ++dy) {
                    DataCopyPad(rows[dy * nr * pitch], input[origin + dy * w], copy, pad);
                }
            } else {
                DataCopyExtParams copy{static_cast<uint16_t>(nr + k - 1), static_cast<uint32_t>(span * sizeof(T)),
                    static_cast<uint32_t>((w - span) * sizeof(T)), 0, 0};
                DataCopyPad(rows, input[origin], copy, pad);
            }
            iq.EnQue(rows);
            rows = iq.DeQue<T>();
            const int32_t loaded = (stride == 2 ? nr * k : nr + k - 1) * pitch;
            auto data = widenRows(rows, wideBuf.Get<float>(), loaded);
            auto vertical = sumBuf.Get<float>();
            auto values = valueBuf.Get<float>();
            if (paired) {
                Add(vertical, data, data[nr * pitch], 2 * used);
                PipeBarrier<PIPE_V>();
                reducePairs(values, vertical, used);
            } else {
                const int32_t len = (used - 1) * stride + k;
                const int32_t nextRow = stride == 2 ? nr * pitch : pitch;
                Add(vertical, data, data[nextRow], len);
                PipeBarrier<PIPE_V>();
                for (int32_t dy = 2; dy < k; ++dy) {
                    Add(vertical, vertical, data[dy * nextRow], len);
                    PipeBarrier<PIPE_V>();
                }
                auto offsets = offsetBuf.Get<uint32_t>();
                auto next = gatherBuf.Get<float>();
                if (useDoubling) {
                    // Build sums for power-of-two windows by doubling; combine
                    // the binary decomposition of k into the final window.
                    auto powers = powerBuf.Get<float>();
                    int32_t power = 2;
                    int32_t level = 0;
                    int32_t previousLength = used + k - 1;
                    while (power <= k) {
                        const int32_t shift = power / 2;
                        const int32_t length = previousLength - shift;
                        auto source = level == 0 ? vertical : powers[(level - 1) * windowScratch];
                        auto destination = powers[level * windowScratch];
                        Gather(next, source, offsets, shift * sizeof(float), length);
                        PipeBarrier<PIPE_V>();
                        Add(destination, source, next, length);
                        PipeBarrier<PIPE_V>();
                        previousLength = length;
                        power *= 2;
                        ++level;
                    }
                    int32_t topPower = 2;
                    int32_t topIndex = 0;
                    while (topPower * 2 <= k) {
                        topPower *= 2;
                        ++topIndex;
                    }
                    Muls(values, powers[topIndex * windowScratch], 1.0f, used);
                    PipeBarrier<PIPE_V>();
                    int32_t blockOffset = topPower;
                    for (int32_t block = topPower / 2; block >= 1; block /= 2) {
                        if ((k & block) == 0) continue;
                        auto source = block == 1 ? vertical : powers;
                        if (block > 2) {
                            int32_t index = 0;
                            for (int32_t p = 2; p < block; p *= 2) ++index;
                            source = powers[index * windowScratch];
                        }
                        Gather(next, source, offsets, blockOffset * sizeof(float), used);
                        PipeBarrier<PIPE_V>();
                        Add(values, values, next, used);
                        PipeBarrier<PIPE_V>();
                        blockOffset += block;
                    }
                } else {
                    if (stride != 1) {
                        Gather(values, vertical, offsets, 0u, used);
                        PipeBarrier<PIPE_V>();
                    }
                    for (int32_t dx = 1; dx < k; ++dx) {
                        Gather(next, vertical, offsets, dx * sizeof(float), used);
                        PipeBarrier<PIPE_V>();
                        if (stride == 1 && dx == 1) Add(values, vertical, next, used);
                        else Add(values, values, next, used);
                        PipeBarrier<PIPE_V>();
                    }
                }
            }
            PipeBarrier<PIPE_V>();
            iq.FreeTensor(rows);
            auto result = oq.AllocTensor<T>();
            finishRow(result, values, scale, used);
            oq.EnQue(result);
            result = oq.DeQue<T>();
            DataCopyExtParams write{static_cast<uint16_t>(nr), static_cast<uint32_t>(n * sizeof(T)),
                static_cast<uint32_t>(outPitch / align - (n + align - 1) / align),
                static_cast<uint32_t>((wo - n) * sizeof(T)), 0};
            DataCopyPad(output[pos + left], result, write);
            oq.FreeTensor(result);
        }
        pos += nr * width;
    }
}

template <bool halfInput, bool pairWindow, int32_t tileCapacity = OUTPUT_TILE>
__global__ __vector__ void small_pool(GM_ADDR x, GM_ADDR y, int64_t h, int64_t w,
    int64_t ho, int64_t wo, int64_t total, int32_t kernelSize, int32_t step,
    int64_t blocksPerCore, uint32_t extraBlocks)
{
    using T = typename std::conditional<halfInput, half, float>::type;
    constexpr int32_t alignment = 32 / sizeof(T);
    const int32_t k = pairWindow ? 2 : kernelSize;
    const int32_t stride = pairWindow ? 2 : step;
    const uint32_t core = GetBlockIdx();
    const uint32_t precedingExtra = core < extraBlocks ? core : extraBlocks;
    int64_t pos = (core * blocksPerCore + precedingExtra) * alignment;
    int64_t end = pos + (blocksPerCore + (core < extraBlocks)) * alignment;
    if (end > total) end = total;
    const int32_t capacity = wo < tileCapacity ? wo : tileCapacity;
    const int32_t maxSpan = (capacity - 1) * stride + k;
    const int32_t maxPitch = (maxSpan + alignment - 1) / alignment * alignment;
    TPipe pipe;
    TQue<QuePosition::VECIN, 1> iq;
    TQue<QuePosition::VECOUT, 1> oq;
    TBuf<QuePosition::VECCALC> sumBuf, scratchBuf, offsetBuf, gatherBuf, resultBuf;
    pipe.InitBuffer(iq, 1, k * maxPitch * sizeof(T));
    pipe.InitBuffer(oq, 1, tileCapacity * sizeof(T));
    pipe.InitBuffer(sumBuf, maxPitch * sizeof(float));
    pipe.InitBuffer(scratchBuf, maxPitch * sizeof(float));
    if (!pairWindow) {
        pipe.InitBuffer(offsetBuf, tileCapacity * sizeof(uint32_t));
        pipe.InitBuffer(gatherBuf, tileCapacity * sizeof(float));
    }
    pipe.InitBuffer(resultBuf, tileCapacity * sizeof(float));
    GlobalTensor<T> input, output;
    input.SetGlobalBuffer((__gm__ T*)x);
    output.SetGlobalBuffer((__gm__ T*)y);
    if (!pairWindow) {
        const int32_t offsetCount = end - pos < capacity ? end - pos : capacity;
        makeOffsets(scratchBuf.Get<float>(), offsetBuf.Get<int32_t>(), stride, offsetCount);
    }
    auto vertical = sumBuf.Get<float>();
    auto values = resultBuf.Get<float>();
    int64_t row, col, batch;
    if (pos <= UINT32_MAX && ho <= UINT32_MAX && wo <= UINT32_MAX) {
        const uint32_t index = static_cast<uint32_t>(pos);
        const uint32_t width = static_cast<uint32_t>(wo);
        const uint32_t height = static_cast<uint32_t>(ho);
        const uint32_t line = index / width;
        col = index % width;
        row = line % height;
        batch = line / height;
    } else {
        const int64_t line = pos / wo;
        col = pos % wo;
        row = line % ho;
        batch = line / ho;
    }
    while (pos < end) {
        int32_t n = capacity;
        if (n > wo - col) n = wo - col;
        if (n > end - pos) n = end - pos;
        const int32_t span = (n - 1) * stride + k;
        const int32_t pitch = (span + alignment - 1) / alignment * alignment;
        const int64_t origin = (batch * h + row * stride) * w + col * stride;
        auto rows = iq.AllocTensor<T>();
        DataCopyExtParams copy{static_cast<uint16_t>(k), static_cast<uint32_t>(span * sizeof(T)),
                               static_cast<uint32_t>((w - span) * sizeof(T)), 0, 0};
        DataCopyPadExtParams<T> pad{false, 0, 0, 0};
        DataCopyPad(rows, input[origin], copy, pad);
        iq.EnQue(rows);
        rows = iq.DeQue<T>();
        if (pairWindow) {
            addRowPair(vertical, scratchBuf.Get<float>(), rows, pitch, span);
            PipeBarrier<PIPE_V>();
            reducePairs(values, vertical, n);
        } else {
            Duplicate(vertical, 0.0f, span);
            PipeBarrier<PIPE_V>();
            for (int32_t dy = 0; dy < k; ++dy) {
                accumulate(vertical, rows[dy * pitch], scratchBuf.Get<float>(), span);
                PipeBarrier<PIPE_V>();
            }
            auto offsets = offsetBuf.Get<uint32_t>();
            auto gathered = gatherBuf.Get<float>();
            Gather(values, vertical, offsets, 0u, n);
            for (int32_t dx = 1; dx < k; ++dx) {
                Gather(gathered, vertical, offsets, dx * sizeof(float), n);
                PipeBarrier<PIPE_V>();
                Add(values, values, gathered, n);
                PipeBarrier<PIPE_V>();
            }
        }
        iq.FreeTensor(rows);
        PipeBarrier<PIPE_V>();
        auto result = oq.AllocTensor<T>();
        finishRow(result, values, 1.0f / (k * k), n);
        oq.EnQue(result);
        result = oq.DeQue<T>();
        DataCopyExtParams write{1, static_cast<uint32_t>(n * sizeof(T)), 0, 0, 0};
        DataCopyPad(output[pos], result, write);
        oq.FreeTensor(result);
        pos += n;
        col += n;
        if (col == wo) {
            col = 0;
            if (++row == ho) {
                row = 0;
                ++batch;
            }
        }
    }
}

template <typename T>
__global__ __vector__ void avg_pool2_d_custom(GM_ADDR x, GM_ADDR y, int64_t h, int64_t w,
    int64_t ho, int64_t wo, int64_t total, int64_t k, int64_t s)
{
    Pool<T> pool;
    pool.run(x, y, h, w, ho, wo, total, k, s);
}

extern "C" void run_kernel(GM_ADDR x, const TensorGroupInfo& info_x, GM_ADDR y,
    const TensorGroupInfo& info_y, int64_t availableCoreNum, aclrtStream stream,
    int64_t kernel_size, int64_t stride)
{
    const auto* in = info_x.tensors[0].shape;
    const auto* out = info_y.tensors[0].shape;
    const int64_t total = out[0] * out[1] * out[2];
    if (total == 0) return;
    // Small windows fit in one strided DMA. Bound the GM byte stride as well.
    if (kernel_size <= 8 && stride <= 8 && in[2] <= INT32_MAX / 4) {
        const int32_t align = info_x.tensors[0].dtype == 0 ? 8 : 16;
        const int64_t blocks = (total + align - 1) / align;
        const uint32_t cores = availableCoreNum < 1 ? 1 : (blocks < availableCoreNum ? blocks : availableCoreNum);
        const int64_t lines = total / out[2];
        int32_t rows = 1;
        while ((rows * out[2]) % align != 0) rows *= 2;
        if (rows < 2) rows = 2;
        int64_t unit = rows * out[2];
        uint32_t stripCores = cores;
        // Keep core intervals row-aligned so each worker can fill a strip batch.
        const int64_t groups = (total - 1) / unit + 1;
        if (groups < stripCores) stripCores = groups;
        // Avoid giving a core fewer rows than one full strip transaction.
        const int64_t rowCores = (lines + STRIP_ROWS - 1) / STRIP_ROWS;
        if (rowCores < stripCores) stripCores = rowCores;
        const bool useStrip = out[1] >= 2 && out[2] >= 16 && lines / stripCores >= 2;
        if (useStrip && stride == 1 && kernel_size >= 2) {
            if (info_x.tensors[0].dtype == 0) {
                strip_pool<false, 1><<<stripCores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, unit);
            } else {
                strip_pool<true, 1><<<stripCores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, unit);
            }
            return;
        }
        if (useStrip && stride == 2 && in[2] <= INT32_MAX / 8 && (kernel_size == 2 || kernel_size == 3)) {
            if (info_x.tensors[0].dtype == 0) {
                strip_pool<false, 2><<<stripCores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, unit);
            } else {
                strip_pool<true, 2><<<stripCores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, unit);
            }
            return;
        }
        const int64_t blocksPerCore = blocks / cores;
        const uint32_t extraBlocks = blocks % cores;
        if (kernel_size == 2 && stride == 2) {
            if (info_x.tensors[0].dtype == 0) {
                small_pool<false, true><<<cores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, 2, 2, blocksPerCore, extraBlocks);
            } else {
                small_pool<true, true><<<cores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, 2, 2, blocksPerCore, extraBlocks);
            }
            return;
        }
        if (info_x.tensors[0].dtype == 0) {
            small_pool<false, false><<<cores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, stride, blocksPerCore, extraBlocks);
        } else {
            small_pool<true, false><<<cores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, stride, blocksPerCore, extraBlocks);
        }
        return;
    }
    const int64_t tiles = (total - 1) / OUTPUT_TILE + 1;
    const uint32_t cores = availableCoreNum < 1 ? 1 : (tiles < availableCoreNum ? tiles : availableCoreNum);
    if (stride == 1 && kernel_size >= 9 && kernel_size <= 32 &&
        out[1] >= STRIP_ROWS && out[2] >= 2 * kernel_size && total <= INT32_MAX &&
        in[2] <= INT32_MAX / 4) {
        const int32_t align = info_x.tensors[0].dtype == 0 ? 8 : 16;
        int32_t groupRows = 4;
        while (groupRows * out[2] % align != 0) groupRows *= 2;
        const int64_t unit = groupRows * out[2];
        if (total / unit >= cores) {
            if (info_x.tensors[0].dtype == 0) {
                strip_pool<false, 1, true><<<cores, nullptr, stream>>>(x, y, in[1], in[2],
                    out[1], out[2], total, kernel_size, unit);
            } else {
                strip_pool<true, 1, true><<<cores, nullptr, stream>>>(x, y, in[1], in[2],
                    out[1], out[2], total, kernel_size, unit);
            }
            return;
        }
    }
    // Vector row fallback covers medium windows that cannot reuse complete
    // strips. Capacity is reduced with K so both dtypes remain below 192 KiB.
    if (kernel_size <= 64 && stride <= 8 && in[2] <= INT32_MAX / 4) {
        const int32_t align = info_x.tensors[0].dtype == 0 ? 8 : 16;
        const int64_t blocks = (total + align - 1) / align;
        const uint32_t vectorCores = availableCoreNum < 1 ? 1 :
            (blocks < availableCoreNum ? blocks : availableCoreNum);
        const int64_t blocksPerCore = blocks / vectorCores;
        const uint32_t extraBlocks = blocks % vectorCores;
        if (info_x.tensors[0].dtype == 0) {
            if (kernel_size <= 16) {
                small_pool<false, false, 256><<<vectorCores, nullptr, stream>>>(x, y, in[1], in[2],
                    out[1], out[2], total, kernel_size, stride, blocksPerCore, extraBlocks);
            } else if (kernel_size <= 32) {
                small_pool<false, false, 128><<<vectorCores, nullptr, stream>>>(x, y, in[1], in[2],
                    out[1], out[2], total, kernel_size, stride, blocksPerCore, extraBlocks);
            } else {
                small_pool<false, false, 64><<<vectorCores, nullptr, stream>>>(x, y, in[1], in[2],
                    out[1], out[2], total, kernel_size, stride, blocksPerCore, extraBlocks);
            }
        } else {
            if (kernel_size <= 32) {
                small_pool<true, false, 256><<<vectorCores, nullptr, stream>>>(x, y, in[1], in[2],
                    out[1], out[2], total, kernel_size, stride, blocksPerCore, extraBlocks);
            } else {
                small_pool<true, false, 128><<<vectorCores, nullptr, stream>>>(x, y, in[1], in[2],
                    out[1], out[2], total, kernel_size, stride, blocksPerCore, extraBlocks);
            }
        }
        return;
    }
    if (info_x.tensors[0].dtype == 0) {
        avg_pool2_d_custom<float><<<cores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, stride);
    } else {
        avg_pool2_d_custom<half><<<cores, nullptr, stream>>>(x, y, in[1], in[2], out[1], out[2], total, kernel_size, stride);
    }
}
